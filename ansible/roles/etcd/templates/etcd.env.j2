ETCD_NAME={{ inventory_hostname }}
ETCD_DATA_DIR={{ etcd_data_dir }}
ETCD_LISTEN_PEER_URLS=http://{{ node_private_ip }}:{{ etcd_peer_port }}
ETCD_LISTEN_CLIENT_URLS=http://{{ node_private_ip }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }}
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://{{ node_private_ip }}:{{ etcd_peer_port }}
ETCD_ADVERTISE_CLIENT_URLS=http://{{ node_private_ip }}:{{ etcd_client_port }}
ETCD_INITIAL_CLUSTER={% for host in groups['postgres'] %}{{ host }}=http://{{ hostvars[host].node_private_ip }}:{{ etcd_peer_port }}{{ '' if loop.last else ',' }}{% endfor %}

ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN={{ etcd_cluster_token }}
ETCD_AUTO_COMPACTION_MODE=periodic
ETCD_AUTO_COMPACTION_RETENTION={{ etcd_auto_compaction_retention }}
ETCD_LOG_LEVEL={{ etcd_log_level }}
